# Copy to `.env` and adjust.  `.env` is git-ignored and must never be committed.
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# Local Android emulator — every value has a working default, so this section
# is optional. It exists so you can point at a different AVD or .apk.
# ─────────────────────────────────────────────────────────────────────────────

# Name of the AVD, exactly as `emulator -list-avds` prints it.
ANDROID_AVD_NAME=Pixel_7_API_34

# Android version matching the AVD's API level. API 34 = Android 14.
ANDROID_PLATFORM_VERSION=14

# Path to the .apk. Relative paths resolve from the repo root.
ANDROID_APP_PATH=apps/android.wdio.native.app.apk

# ─────────────────────────────────────────────────────────────────────────────
# BrowserStack App Automate — REQUIRED for `npm run test:bstack`.
# The config throws at load time if any of these three is missing, before a
# billed session opens.
# ─────────────────────────────────────────────────────────────────────────────

# From https://www.browserstack.com/accounts/profile/details
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# The bs:// id (or custom_id) of the ANDROID app. See "Uploading the app" in README.md.
#
# NOT named BROWSERSTACK_APP_ID: that name is reserved by the BrowserStack SDK, which
# treats it as "the app for this run" and lets it override the app the config asks for.
# Leaving an Android id in it starts an Android build on an iPhone.
BROWSERSTACK_ANDROID_APP_ID=

# Optional — the Android device to run on. Must match a device string from
# BrowserStack's App Automate device list.
BROWSERSTACK_DEVICE=Google Pixel 8
BROWSERSTACK_OS_VERSION=14.0

# ─────────────────────────────────────────────────────────────────────────────
# BrowserStack — iOS (`npm run test:ios:bstack`)
#
# Separate ids and device names from the Android pair above, so both platforms
# can be configured at once and composed into a single Allure report.
# ─────────────────────────────────────────────────────────────────────────────

# The bs:// id (or custom_id) of BStackSampleApp.ipa. REQUIRED for the iOS run.
BROWSERSTACK_IOS_APP_ID=

# Optional — the iOS device to run on. Defaults to iPhone 14 / 18.
BROWSERSTACK_IOS_DEVICE=iPhone 14
BROWSERSTACK_IOS_OS_VERSION=18

# Optional — groups sessions in the dashboard. A run counter is appended
# automatically, so the same value across runs is fine.
BROWSERSTACK_BUILD_NAME=Android — WebdriverIO Demo App

# ─────────────────────────────────────────────────────────────────────────────
# Reporting
# ─────────────────────────────────────────────────────────────────────────────

# Optional — recorded as App.Version in the Allure report's Environment widget.
# Neither Appium nor BrowserStack reports the app's versionName, so if you want
# it in the report, set it here.
APP_VERSION=
