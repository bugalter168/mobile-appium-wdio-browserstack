{
  "name": "wdio-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile test automation for the WebdriverIO Demo App (Android) — WebdriverIO v9 + Appium + TypeScript + Mocha.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "test:local": "npm run report:clean && wdio run ./config/wdio.android.local.conf.ts",
    "test:bstack": "wdio run ./config/wdio.android.bstack.conf.ts",
    "report:clean": "node scripts/clean-allure-results.mjs",
    "report:generate": "allure generate allure-results --clean --output allure-report --report-name \"WDIO Mobile Automation\"",
    "report:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^24.0.0",
    "@wdio/allure-reporter": "^9.29.1",
    "@wdio/appium-service": "^9.29.1",
    "@wdio/browserstack-service": "^9.33.0",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.2.0",
    "deepmerge-ts": "^7.1.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "webdriverio": "^9.29.1"
  }
}
